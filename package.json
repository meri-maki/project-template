        "eslint-plugin-react-refresh": "^0.4.5",
        "fs-extra": "^10.1.0",
        "husky": "^9.0.11",
        "i18n-unused": "^0.16.0",
        "postcss-scss": "^4.0.9",
        "prettier": "^3.2.5",
