        "i18next-browser-languagedetector": "^8.0.0",
        "i18next-chained-backend": "^4.6.2",
        "i18next-resources-to-backend": "^1.2.1",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "react-hot-toast": "^2.5.2",
        "react-i18next": "^14.1.2",
        "react-router": "^6.22.2",
        "react-router-dom": "^6.22.2",
        "react-tooltip": "^5.28.1",
        "swiper": "^11.2.8",
        "zustand": "^4.5.2"
    },
